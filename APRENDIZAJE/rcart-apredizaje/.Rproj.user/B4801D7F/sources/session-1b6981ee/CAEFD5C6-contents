# Apartado b)  El segundo objetivo del algoritmo es determinar dos árboles T1 y T2 de dos niveles tal que T1
# explote la región derecha (es decir R2) con el algoritmo descrito anteriormente, mientra que T2
# explota la izquierda. Por ultimo, predecimos el conjunto completo de resultados usando ambos
# arboles. Nos quedaremos con el árbol que mejor predicción realice.

cat("Apartado b) \n")

calc_node_prediction <- function(data) {
  t <- sum(data$y == 0)
  r <- sum(data$y == 1)
  return(c(t, r))
}

print_tree <- function(tree, level = 0, side = "Root") {
  
  cat("Nivel 0\n")
  cat("\tNodo 1 (o raíz):", tree$split_var, "<", tree$split_value, "\n")
  
  cat("Nivel 1\n")
  
  format_prediction <- function(pred) {
    return(paste0("(", pred[1], ", ", pred[2], ")"))
  }
  
  cat("\tDerecha\n")
  if (!tree$right$isLeaf) {
    cat("\t\tNodo 2:", tree$right$split_var, "<", tree$right$split_value, "\n")
    cat("\t\t\t", format_prediction(tree$right$left$prediction), "-", format_prediction(tree$right$right$prediction), "\n")
  } else {
    cat("\t\t", format_prediction(tree$right$prediction), "\n")
  }
  
  cat("\tIzquierda\n")
  if (!tree$left$isLeaf) {
    cat("\t\tNodo 2:", tree$left$split_var, "<", tree$left$split_value, "\n")
    cat("\t\t\t", format_prediction(tree$left$left$prediction), "-", format_prediction(tree$left$right$prediction), "\n")
  } else {
    cat("\t\t", format_prediction(tree$left$prediction), "\n")
  }
  
  cat("\n")
}

# Función para predecir usando el árbol personalizado
predict_custom_cart <- function(tree, newdata) {
  predictions <- matrix(0, nrow = nrow(newdata), ncol = 2)
  
  for (i in 1:nrow(newdata)) {
    node <- tree
    while (!node$isLeaf) {
      if (newdata[i, node$split_var] < node$split_value) {
        node <- node$left
      } else {
        node <- node$right
      }
    }
    predictions[i,] <- node$prediction
  }
  
  return(predictions)
}


# Dividir el dataset en R1 (izquierda) y R2 (derecha) usando la mejor división dada en el apartado a)
