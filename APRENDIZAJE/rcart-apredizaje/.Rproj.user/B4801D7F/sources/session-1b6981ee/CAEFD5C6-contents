R2 <- data[data[best_split$mejorxj] >= best_split$mejorS, ]


# Función para entrenar un árbol CART personalizado
train_custom_cart <- function(data, depth = 2) {
  
  if (depth == 0 || nrow(data) <= 1) {
    return(list(prediction = calc_node_prediction(data), isLeaf = TRUE))
  }
  
  split <- find_best_split(data)
  
  left_data <- data[data[[split$mejorxj]] < split$mejorS, ]
  right_data <- data[data[[split$mejorxj]] >= split$mejorS, ]
  
  left_branch <- train_custom_cart(left_data, depth - 1)
  right_branch <- train_custom_cart(right_data, depth - 1)
  
  return(list(
    split_var = split$mejorxj,
    split_value = split$mejorS,
    left = left_branch,
    right = right_branch,
    isLeaf = FALSE,
    prediction = calc_node_prediction(data)
  ))
}

