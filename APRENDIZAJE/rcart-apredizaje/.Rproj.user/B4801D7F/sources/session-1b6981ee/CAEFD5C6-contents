# Función principal
busca_mejor_corte <- function(df, verbose = TRUE) {
  mejor_var <- NA
  mejor_val <- NA
  mejor_error <- Inf
  
  predictores <- names(df)[names(df) != "y"]
  
  for (var in predictores) {
    for (s in unique(df[[var]])) {
      izq <- df[df[[var]] < s, ]
      der <- df[df[[var]] >= s, ]
      
      if (nrow(izq) == 0 || nrow(der) == 0) next
      
      rss <- sum((izq$y - mean(izq$y))^2) +
        sum((der$y - mean(der$y))^2)
      
      if (verbose) {
        cat("Variable:", var,
            "| Corte en:", s,
            "| RSS:", round(rss, 3), "\n")
      }
      
      if (rss < mejor_error) {
        mejor_error <- rss
        mejor_var <- var
        mejor_val <- s
      }
    }
  }
  
  cat("\n>>> Mejor división encontrada:",
      mejor_var, "<", mejor_val,
      "con RSS =", round(mejor_error, 3), "\n")
  
  return(list(variable = mejor_var,
              corte = mejor_val,
              error = mejor_error))
}

