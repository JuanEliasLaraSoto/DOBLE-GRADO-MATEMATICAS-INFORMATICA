run_svm_1d <- function(x_vec, y_fac, test_points, plot_title="SVM 1D (Caso e)") {
X <- matrix(x_vec, ncol=1)
model <- svm(X, y_fac,
type="C-classification",
kernel="linear",
cost=1e6,
scale=FALSE)
cat("\n VECTORES SOPORTE \n")
print(model$SV)
# Matriz Kernel
K <- outer(x_vec, x_vec, "*")
cat("\n MATRIZ KERNEL \n")
print(K)
# w = sum(alpha_i * y_i * x_i)
alphas <- as.numeric(model$coefs)
SV <- as.numeric(model$SV)
w <- sum(alphas * SV)
cat("\n w \n"); print(w)
b <- -as.numeric(model$rho)
cat("\n b \n"); print(b)
# Umbral y márgenes
if (abs(w) > 1e-9) {
x0 <- -b / w
x_plus  <- (-b + 1) / w
x_minus <- (-b - 1) / w
margin <- 1 / abs(w)
} else {
x0 <- NA; x_plus <- NA; x_minus <- NA; margin <- Inf
}
cat("\n ECUACIÓN DE DECISIÓN (1D) \n")
cat(sprintf("H(x) = %.4f*x + %.4f\n", w, b))
cat("Frontera H(x)=0 → x =", x0, "\n")
cat("Margen =", margin, "\n")
# Clasificación del punto 4.5
preds <- predict(model, matrix(test_points, ncol=1))
cat("\n CLASIFICACIÓN DEL PUNTO \n")
print(cbind(x=test_points, Clase=preds))
# Gráfico
plot(x_vec, rep(0,length(x_vec)),
col=ifelse(y_fac==1,"blue","red"), pch=19,
xlab="x", ylab="", yaxt="n", main=plot_title)
abline(h=0, lty=3)
if (!is.na(x0)) abline(v=x0, lwd=2)
if (!is.na(x_plus))  abline(v=x_plus,  lty=2)
if (!is.na(x_minus)) abline(v=x_minus, lty=2)
points(test_points, 0, pch=17, cex=1.4)
}
