library(e1071)
run_svm <- function(X, Y, test_points, plot_title="SVM Practica 3") {
# 1. Entrenar SVM lineal sin suavizado (C muy grande)
model <- svm(X, Y,
type="C-classification",
kernel="linear",
cost=1e6,
scale=FALSE)
# 2. Vectores soporte
cat("\n--- VECTORES SOPORTE ---\n")
print(model$SV)
# 3. Matriz Kernel (dot-product)
n <- nrow(X)
K <- matrix(0, n, n)
for (i in 1:n) {
for (j in 1:n) {
K[i,j] <- sum(X[i,]*X[j,])
}
}
cat("\n MATRIZ KERNEL K (dot product) \n")
print(K)
# 4. Vector de pesos W = sum(alpha_i * y_i * x_i)
alphas <- model$coefs
SV <- model$SV
# Multiplicación correcta: cada fila de SV multiplicada por su alpha_i
W <- colSums(sweep(SV, 1, alphas, "*"))
cat("\n VECTOR W \n")
print(W)
# 5. Sesgo b
b <- -model$rho
cat("\n BIAS b \n")
print(b)
# 6. Ecuación del hiperplano
cat("\n ECUACIÓN DEL HIPERPLANO \n")
cat(sprintf("H(x) = %.4f*x1 + %.4f*x2 + (%.4f) = 0\n", W[1], W[2], b))
# Planos de soporte
margin <- 1 / sqrt(sum(W^2))
channel_width <- 2 * margin #
cat(sprintf("Margen = %.4f\n", margin))
cat(sprintf("Ancho del Canal = %.4f\n", channel_width))
cat("\nHiperplano positivo: W·x + b = +1\n")
cat("Hiperplano negativo: W·x + b = -1\n")
# 7. Clasificar puntos de prueba
cat("\n CLASIFICACIÓN DE PUNTOS \n")
preds <- predict(model, test_points)
print(cbind(test_points, Clase=preds))
# 8. Gráfica
plot(X, col=ifelse(Y==1,"blue","red"), pch=19, main=plot_title)
abline(a = -b/W[2], b = -W[1]/W[2], col="black", lwd=2)   # hiperplano
abline(a = (1-b)/W[2], b = -W[1]/W[2], col="green", lty=2) # soporte +
abline(a = (-1-b)/W[2], b = -W[1]/W[2], col="green", lty=2) # soporte -
}
X <- matrix(c(0,0,
4,4), ncol=2, byrow=TRUE)
Y <- c(1, -1)
test_points <- matrix(c(5,6,
1,-4), ncol=2, byrow=TRUE)
