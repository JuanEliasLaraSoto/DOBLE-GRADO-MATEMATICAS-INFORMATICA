clear all;

D = load('handwriting.mat');
X = D.X;

[N, K] = size(X);
J = 10;

Y = zeros(N,J);

% Generate the Y Label
for i =1:10
    Y(1+(500*(i-1)):i*500,i) =1;
end

% Scale the data
Xscaled = (X-min(X))./(max(X)-min(X));

% Remove the NaN elements
Xscaled = Xscaled(:,any(~isnan(Xscaled)));

% Compute again the number of total elements and attributes
[N, K] = size(Xscaled);

% Mezclamos los índices aleatoriamente
idx = randperm(N);

% 25% de los datos para test
Ntest = round(0.25 * N);
idxTest = idx(1:Ntest);
idxTrain = idx(Ntest+1:end);

% Conjunto de entrenamiento y test
XscaledTrain = Xscaled(idxTrain, :);
YTrain = Y(idxTrain, :);
XscaledTest = Xscaled(idxTest, :);
YTest = Y(idxTest, :);

% Ahora creamos validación dentro del entrenamiento (25% del train)
NTrain = size(XscaledTrain, 1);
idx2 = randperm(NTrain);
Nval = round(0.25 * NTrain);
idxVal = idx2(1:Nval);
idxTrainVal = idx2(Nval+1:end);

% Conjunto de validación y entrenamiento para hiperparámetros
XscaledTrainVal = XscaledTrain(idxTrainVal, :);
YTrainVal = YTrain(idxTrainVal, :);
XscaledVal = XscaledTrain(idxVal, :);
YVal = YTrain(idxVal, :);
% Performance Matrix
Performance = zeros(7,6);

i = 0;
j = 0;
% Estimate the hyper-parameters values
for C = [10^(-3) 10^(-2) 10^(-1) 1 10 100 1000]
    i = i+1;
    for L = [50 100 500 1000 1500 2000]
        j = j + 1;

        % --- Implementación del ELM neuronal ---
        % Inicialización aleatoria de los pesos de la capa oculta
        t = 2 * rand(L, K) - 1;  

        % Cálculo de la activación en la capa oculta (función sigmoide)
        Htrain = 1 ./ (1 + exp(-(t * XscaledTrainVal')));

        % Cálculo analítico de los pesos de salida con regularización (ridge)
        W = ((eye(L) / C) + (Htrain * Htrain')) \ (Htrain * YTrainVal);

        % Evaluación del modelo sobre el conjunto de validación
        Hval = 1 ./ (1 + exp(-(t * XscaledVal')));
        Ypred_val = (Hval' * W);

        % Cálculo del error cuadrático medio (MSE) en validación
        Performance(i, j) = mean((Ypred_val - YVal).^2, 'all');

    end
    j=0;
end

C = [10^(-3) 10^(-2) 10^(-1) 1 10 100 1000];
L = [50 100 500 1000 1500 2000];

[minValue, linearIndexesOfMins] = min(Performance(:));
[rowsOfMins, colsOfMins] = find(Performance == minValue);

Copt = C(rowsOfMins(1));
Lopt = L(colsOfMins(1));


% Calcular con el conjunto de entrenamiento el ELM neuronal y
% reportar el error cometido en test
%  Entrenar el modelo con los hiperparámetros óptimos 
t = 2 * rand(Lopt, K) - 1;

% Calcular la salida de la capa oculta con los datos de entrenamiento
Htrain = 1 ./ (1 + exp(-(t * XscaledTrain')));

% Calcular los pesos de salida con regularización
W = ((eye(Lopt) / Copt) + (Htrain * Htrain')) \ (Htrain * YTrain);

%  Evaluar el modelo sobre el conjunto de prueba 
Htest = 1 ./ (1 + exp(-(t * XscaledTest')));
YTestE = Htest' * W;

% Calcular el Error Cuadrático Medio (MSE) en test
mse_test = mean((YTestE - YTest).^2, 'all');
fprintf(['Error Cuadrático Medio ' ...
    '(MSE) en el conjunto de prueba: %.4f\n'], mse_test);

% Calcular la Tasa de Clasificación Correcta (CCR)
[~, Ypred_labels] = max(YTestE, [], 2);    % Clase predicha
[~, Ytrue_labels] = max(YTest, [], 2);     % Clase real

% Porcentaje de aciertos
CCR = mean(Ypred_labels == Ytrue_labels) * 100;

fprintf('Tasa de Clasificación Correcta (CCR) en el conjunto de prueba: %.2f%%\n', CCR);
